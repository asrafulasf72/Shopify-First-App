{{ 'gift-tier.css' | asset_url | stylesheet_tag }}

<div class="bb-bundle-widget">
  {% render 'bundle-header' %}
  {% render 'bundle-timer' %}

  <div class="bb-toppick-card">
    <span class="bb-toppick-badge">Top Pick</span>

    <div class="bb-toppick-main">
      <div class="bb-toppick-left">
        <span class="bb-radio bb-radio-checked"></span>
        <div class="bb-toppick-info">
          <p class="bb-toppick-name">Single pack</p>
          <p class="bb-toppick-subtext">No discount</p>
        </div>
      </div>
      <span class="bb-toppick-price">$29.99</span>
    </div>

    <div class="bb-color-row">
      <label class="bb-color-label">Color #1</label>
      <div class="bb-select-wrap">
        <select class="bb-select">
          <option>Black</option>
        </select>
      </div>
    </div>

    {% render 'gift-box' %}
  </div>

  <div class="bb-tier-options">
    <div class="bb-tier-option">
      <div class="bb-tier-option-left">
        <span class="bb-radio bb-radio-unchecked"></span>
        <div class="bb-tier-option-info">
          <p class="bb-tier-option-name">Duo pack</p>
          <p class="bb-tier-option-subtext">Save $6.78 &middot; $24.64 / item</p>
        </div>
      </div>
      <div class="bb-tier-option-right">
        <span class="bb-tier-option-price">$52.99</span>
        <span class="bb-tier-option-strike">$52.99</span>
      </div>
    </div>

    <div class="bb-tier-option">
      <div class="bb-tier-option-left">
        <span class="bb-radio bb-radio-unchecked"></span>
        <div class="bb-tier-option-info">
          <p class="bb-tier-option-name">Family pack</p>
          <p class="bb-tier-option-subtext">Save $6.78 &middot; $24.64 / item</p>
        </div>
      </div>
      <div class="bb-tier-option-right">
        <span class="bb-tier-option-price">$69.99</span>
        <span class="bb-tier-option-strike">$52.99</span>
      </div>
    </div>
  </div>

  {% render 'bundle-cta' %}
</div>

{% schema %}
{
  "name": "Gift tier",
  "target": "section",
  "settings": []
}
{% endschema %}
