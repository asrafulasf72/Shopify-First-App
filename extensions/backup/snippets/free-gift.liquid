{{ 'free-gift.css' | asset_url | stylesheet_tag }}
<div class="bb-free-gift">
  <span class="bb-free-gift-checkbox"></span>
  <img
    class="bb-free-gift-image"
    src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=400"
    alt="Street Runner"
    width=""
      height=""
  />
  <div class="bb-free-gift-info">
    <p class="bb-free-gift-name">+FREE Gift</p>
    <p class="bb-free-gift-subtext">Vitamin e hair serum</p>
  </div>
  {% comment %} <span class="bb-addon-price">+ $6</span> {% endcomment %}
</div>