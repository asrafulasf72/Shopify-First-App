{%- comment -%} SNIPPET: bb-modal — variant picker, hidden by default, opened via JS {%- endcomment -%}
<div class="bb-modal-overlay">
  <div class="bb-modal" role="dialog" aria-modal="true" aria-labelledby="bb-modal-title">

    <div class="bb-modal-header">
      <h3 id="bb-modal-title" class="bb-modal-title">Select your variant</h3>
      <button type="button" class="bb-modal-close" data-bb-modal-close aria-label="Close">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
          <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="bb-modal-product">
      <div class="bb-modal-product-image">{{ 'product-1' | placeholder_svg_tag: 'bb-product-image-tag' }}</div>
      <div class="bb-modal-product-info">
        <span class="bb-modal-product-name">Foaming Cleanser</span>
        <span class="bb-modal-product-price">$18.00</span>
      </div>
    </div>

    <div class="bb-modal-group">
      <h4 class="bb-modal-group-title">Color</h4>
      <div class="bb-swatch-row" data-bb-scroll-drag>
