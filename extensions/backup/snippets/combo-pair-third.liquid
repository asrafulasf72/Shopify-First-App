{{ 'combo-pair-third.css' | asset_url | stylesheet_tag }}

<div class="bb-combo-pair-third">

  <!-- Item 1 -->
  <article class="bb-combo-pair-third-item">
    <div class="bb-combo-pair-third-media">
      <img src="https://picsum.photos/seed/vitamin-c-serum/120/120" alt="Street Runner" width="62" height="62" loading="lazy">
    </div>

    <div class="bb-combo-pair-third-details">
      <h3 class="bb-combo-pair-third-title">Street Runner</h3>

      <div class="bb-combo-pair-third-field">
        <label class="bb-combo-pair-third-label" for="bb-combo-pair-third-color-1">Color</label>
        <div class="bb-combo-pair-third-select-wrap">
          <select class="bb-combo-pair-third-select" id="bb-combo-pair-third-color-1">
            <option>Black</option>
            <option>White</option>
            <option>Red</option>
          </select>
          <svg class="bb-combo-pair-third-chevron" width="12" height="8" viewBox="0 0 14 9" fill="none" aria-hidden="true">
            <path d="M1.5 1.5L7 7l5.5-5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="bb-combo-pair-third-price">
      <span class="bb-combo-pair-third-price-current">$300.00</span>
      <del class="bb-combo-pair-third-price-old">$500.00</del>
    </div>
  </article>

  <!-- Divider with add button -->
  <div class="bb-combo-pair-third-divider">
    <button class="bb-combo-pair-third-add" type="button" aria-label="Add item">
      <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Item 2 -->
  <article class="bb-combo-pair-third-item">
    <div class="bb-combo-pair-third-media">
      <img src="https://picsum.photos/seed/vitamin-c-serum/120/120" alt="Street Runner" width="62" height="62" loading="lazy">
    </div>

    <div class="bb-combo-pair-third-details">
      <h3 class="bb-combo-pair-third-title">Street Runner</h3>

      <div class="bb-combo-pair-third-field">
        <label class="bb-combo-pair-third-label" for="bb-combo-pair-third-color-2">Color</label>
        <div class="bb-combo-pair-third-select-wrap">
          <select class="bb-combo-pair-third-select" id="bb-combo-pair-third-color-2">
            <option>Black</option>
            <option>White</option>
            <option>Red</option>
          </select>
          <svg class="bb-combo-pair-third-chevron" width="12" height="8" viewBox="0 0 14 9" fill="none" aria-hidden="true">
            <path d="M1.5 1.5L7 7l5.5-5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="bb-combo-pair-third-select-wrap">
          <select class="bb-combo-pair-third-select" id="bb-combo-pair-third-color-3" aria-label="Second color">
            <option>Black</option>
            <option>White</option>
            <option>Red</option>
          </select>
          <svg class="bb-combo-pair-third-chevron" width="12" height="8" viewBox="0 0 14 9" fill="none" aria-hidden="true">
            <path d="M1.5 1.5L7 7l5.5-5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <div class="bb-combo-pair-third-field">
        <label class="bb-combo-pair-third-label" for="bb-combo-pair-third-size-1">Size</label>
        <div class="bb-combo-pair-third-select-wrap">
