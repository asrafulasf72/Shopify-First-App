{{ 'single-pair.css' | asset_url | stylesheet_tag }}
<div class="bb-bundle-option">
  <input
    class="bb-bundle-option-radio"
    type="radio"
    name="bundle-choice"
    id="bundle-single"
  />

  <div class="bb-bundle-option-info">
    <label class="bb-bundle-option-title" for="bundle-single"> Single pair </label>
    <p class="bb-bundle-option-subtitle">Standard price</p>
  </div>

  <div class="bb-bundle-option-price">
    <span class="bb-bundle-option-price-current">$52.99</span>
    <span class="bb-bundle-option-price-compare">$52.99</span>
  </div>
</div>
