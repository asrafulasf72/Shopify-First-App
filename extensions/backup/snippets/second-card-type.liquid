{{ 'match-builder-card.css' | asset_url | stylesheet_tag }}
<div class="bb-product-card is-empty">
  <div class="bb-product-image ">{{ 'product-3' | placeholder_svg_tag: 'bb-product-image-tag' }}</div>
  <div class="bb-product-info">
    <div class="bb-product-heading-row">
      <span class="bb-product-name">Sample Product</span>
      <span class="bb-product-price">$0.00</span>
    </div>
  </div>
  <div class="bb-product-actions">
    <button type="button" class="bb-btn bb-btn-outline bb-btn-full">Add to bundle</button>
  </div>
</div>
